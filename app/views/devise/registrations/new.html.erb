<div
  class="min-h-screen bg-gray-100 flex items-center justify-center px-4 py-10"
>
  <div class="w-full max-w-2xl bg-white rounded-2xl shadow-xl p-8">

    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900">
        Create your account
      </h1>

      <p class="mt-2 text-gray-500">
        Join the community and start connecting.
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
      html: { multipart: true, class: "space-y-6" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.email_field :email,
                      autofocus: true,
                      autocomplete: "email",
                      class:
                        "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.text_field :username,
                     class:
                       "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-2" %>

          <%= f.text_field :first_name,
                       class:
                         "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-2" %>

          <%= f.text_field :last_name,
                       class:
                         "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

      </div>

      <div>
        <%= f.label :bio, class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.text_area :bio,
                    rows: 4,
                    class:
                      "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= f.label :avatar, class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.file_field :avatar,
                     class:
                       "block w-full text-sm text-gray-600
                  file:mr-4 file:py-2 file:px-4
                  file:rounded-lg file:border-0
                  file:bg-indigo-600 file:text-white
                  hover:file:bg-indigo-700" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-2" %>

        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mb-2">
            Minimum
            <%= @minimum_password_length %>
            characters
          </p>
        <% end %>

        <%= f.password_field :password,
                         autocomplete: "new-password",
                         class:
                           "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= f.label :password_confirmation,
                class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.password_field :password_confirmation,
                         autocomplete: "new-password",
                         class:
                           "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <%= f.submit "Create Account",
               class:
                 "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition" %>

    <% end %>

    <div class="mt-8 text-center text-gray-500">

      Already have an account?
      <span class="font-medium text-indigo-600 hover:text-indigo-700">
        <%= render "devise/shared/links" %>
      </span>

    </div>

  </div>
</div>
